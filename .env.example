# Copy to .env.local and fill in. Never commit .env.local.
# Anthropic API key (console.anthropic.com > Settings > API Keys). Server-side only.
ANTHROPIC_API_KEY=
# YouTube Data API v3 key (console.cloud.google.com, "Public data" API key). Only needed when DEMO_MODE=false.
YOUTUBE_API_KEY=
# true = use the saved snapshot in data/ and cached LLM results; no YouTube calls.
DEMO_MODE=true
# Anthropic model ID used by the server routes.
ANTHROPIC_MODEL=claude-sonnet-5-5
